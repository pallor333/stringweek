function removeXthChar(str, n){//D6
	return str.split('')
      .filter((_, idx) => (idx+1) % n !== 0)
      .join('')
}
function letterSwap(str){ //D7
	const A = 65, Z = 90
	const a = 97, z = 122
	return str.split('').map(ch => {
		let code = ch.charCodeAt(0)
		if(code >= a && code <= z){ //lowercase to uppercase
			return String.fromCharCode(A + (z - code))
		}
		if(code >= A && code <= Z){ //uppercase to lowercase
			return String.fromCharCode(a + (Z - code))
		}
		return ch
	}).join('')
}

